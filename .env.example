# Supabase Database URL (Transaction Pooler or Session Pooler URI)
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# NextAuth secrets (Unused but required if legacy middleware is compiled)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# Default Administrator login credentials
DEFAULT_ADMIN_EMAIL="labelsecurity@mail.com"
DEFAULT_ADMIN_PASSWORD="secure-admin-password-here"

# Web server port (Default is 3001 locally, overridden by Render in production)
PORT=3001

# SMTP Configuration for Email Alerts & Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-alert-sender-email@gmail.com"
SMTP_PASS="your-sender-app-password"
